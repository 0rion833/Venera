  <color slot="text" value="#dcdcdc"/>
  <color slot="dim" value="#a0a0a0"/>
  <color slot="muted" value="#5a5a66"/>
  <color slot="accent" value="#fab283"/>
  <color slot="accent-text" value="#141419"/>
  <color slot="border" value="#2a2a33"/>
  <color slot="success" value="#7fd88f"/>
  <color slot="warn" value="#f5c07a"/>
  <color slot="error" value="#e06c75"/>
  <color slot="pulse" value="#fab283"/>
  <color slot="user" value="#7fd88f"/>
  <color slot="assistant" value="#56b6c2"/>
